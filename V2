    html += '<div class="row">Position<br><b>' + (row ? ordinal(row.position) + ' — ' + row.points + ' pts' : 'Not available') + '</b></div>';
  }
  html += '</a>';
  if (!opts.compact) html += favColourRow(name);
  html += '</div>';
