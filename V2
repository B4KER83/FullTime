<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>U12 Results</title>
<style>
  :root{
    --bg:#0d1117; --card:#161b22; --card-border:#232a35; --text:#e6edf3; --muted:#8b98a5;
    --green:#2ea043; --green-bright:#3fb950; --red:#f85149; --amber:#d29922; --blue:#58a6ff;
    --fav-color:#3fb950;
    --nav-h:64px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    overflow-x:hidden;max-width:100%;}
  body{padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom));
    overscroll-behavior-x:none;touch-action:pan-y;}
  a{color:inherit;text-decoration:none;}
  header.top{position:sticky;top:0;z-index:10;background:#000;border-bottom:1px solid var(--card-border);
    padding:14px 16px calc(14px + env(safe-area-inset-top)) 16px;padding-top:calc(14px + env(safe-area-inset-top));}
  header.top h1{margin:0;font-size:17px;font-weight:700;letter-spacing:.2px;}
  header.top .sub{margin-top:2px;font-size:12px;color:var(--muted);display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;}
  .badge.live{background:rgba(46,160,67,.18);color:var(--green-bright);}
  .badge.stale{background:rgba(210,153,34,.18);color:var(--amber);}
  .badge.error{background:rgba(248,81,73,.18);color:var(--red);}
  main{max-width:640px;margin:0 auto;padding:14px 12px 24px;}
  h2.section{font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);
    margin:22px 4px 10px;}
  h2.section:first-child{margin-top:6px;}
  h3.subsection{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);
    margin:14px 4px 6px;font-weight:700;}
  .card{background:var(--card);border:1px solid var(--card-border);border-radius:12px;padding:12px 14px;margin-bottom:8px;}
  .empty{color:var(--muted);font-size:14px;padding:18px 6px;text-align:center;}
  .banner{border-radius:10px;padding:10px 14px;font-size:13px;margin-bottom:12px;line-height:1.45;}
  .banner.warn{background:rgba(210,153,34,.12);border:1px solid rgba(210,153,34,.35);color:#e3b341;}
  .banner.err{background:rgba(248,81,73,.12);border:1px solid rgba(248,81,73,.35);color:#ff7b72;}
  .match{display:flex;align-items:center;gap:10px;padding:9px 2px;}
  .match + .match{border-top:1px solid var(--card-border);}
  .match .date{width:44px;flex:0 0 44px;font-size:11px;color:var(--muted);line-height:1.2;}
  .match .teams{flex:1;min-width:0;font-size:14px;}
  .match .teams .t{display:flex;justify-content:space-between;gap:6px;align-items:center;}
  .match .teams .name{overflow-wrap:break-word;min-width:0;flex:1 1 auto;}
  .match .teams .name.fav{color:var(--fav-color);font-weight:700;}
  .match .score{font-weight:700;font-variant-numeric:tabular-nums;flex:0 0 auto;font-size:14px;}
  .match .vs{color:var(--muted);font-size:12px;flex:0 0 auto;}
  .match .meta{font-size:11px;color:var(--muted);margin-top:2px;}
  .status-tag{font-size:10px;font-weight:700;text-transform:uppercase;padding:1px 6px;border-radius:6px;margin-left:6px;}
  .status-tag.postponed,.status-tag.cancelled{background:rgba(248,81,73,.18);color:var(--red);}
  .status-tag.rearranged{background:rgba(210,153,34,.18);color:var(--amber);}
  .div-card{display:flex;align-items:center;padding:0;gap:0;}
  .div-card .div-link{flex:1;min-width:0;display:flex;justify-content:space-between;align-items:center;padding:14px;color:inherit;text-decoration:none;}
  .div-card .name{font-size:15px;font-weight:600;overflow-wrap:break-word;}
  .div-card .chev{color:var(--muted);flex:0 0 auto;margin-left:8px;}
  .div-toggle{flex:0 0 auto;background:none;border:none;border-left:1px solid var(--card-border);
    color:var(--muted);font-size:19px;padding:0 16px;min-width:52px;min-height:52px;cursor:pointer;}
  .div-toggle.on{color:var(--green-bright);}
  table.league{width:100%;border-collapse:collapse;font-size:13px;}
  table.league th{text-align:left;color:var(--muted);font-weight:600;font-size:11px;padding:6px 4px;border-bottom:1px solid var(--card-border);}
  table.league td{padding:7px 4px;border-bottom:1px solid var(--card-border);white-space:nowrap;}
  table.league td.team{white-space:normal;max-width:150px;overflow:hidden;text-overflow:ellipsis;}
  .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y;max-width:100%;}
  .star-btn{background:none;border:none;font-size:20px;cursor:pointer;color:var(--amber);padding:4px 6px;line-height:1;}
  .star-btn.off{color:var(--muted);}
  .team-hdr{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;}
  .team-hdr h1{font-size:19px;margin:0 0 4px;}
  .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0;}
  .stat-grid .stat{background:var(--card);border:1px solid var(--card-border);border-radius:10px;padding:8px 4px;text-align:center;}
  .stat-grid .stat .v{font-size:16px;font-weight:700;}
  .stat-grid .stat .l{font-size:10px;color:var(--muted);text-transform:uppercase;margin-top:2px;}
  input.search{width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--card-border);
    background:var(--card);color:var(--text);font-size:15px;margin-bottom:10px;}
  input.search:focus{outline:1px solid var(--green);}
  .tabs{display:flex;gap:6px;margin-bottom:12px;background:var(--card);border:1px solid var(--card-border);border-radius:10px;padding:3px;}
  .tabs button{flex:1;padding:9px 4px;border:none;background:none;color:var(--muted);font-size:13px;font-weight:600;border-radius:8px;cursor:pointer;}
  .tabs button.active{background:var(--green);color:#fff;}
  select.filter{width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--card-border);
    background:var(--card);color:var(--text);font-size:14px;margin-bottom:10px;}
  nav.bottom{position:fixed;bottom:0;left:0;right:0;z-index:20;background:#000;border-top:1px solid var(--card-border);
    display:flex;padding-bottom:env(safe-area-inset-bottom);}
  nav.bottom a{flex:1;text-align:center;padding:9px 2px 7px;font-size:10px;color:var(--muted);}
  nav.bottom a .ic{display:block;font-size:19px;margin-bottom:1px;}
  nav.bottom a.active{color:var(--green-bright);}
  .btn{display:inline-block;background:var(--green);color:#fff;border:none;border-radius:8px;
    padding:9px 16px;font-size:13px;font-weight:600;cursor:pointer;}
  .btn.ghost{background:none;border:1px solid var(--card-border);color:var(--text);}
  .colour-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:4px 0 16px;}
  .colour-swatch{width:34px;height:34px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0;}
  .colour-swatch.on{border-color:var(--text);}
  .colour-custom{width:34px;height:34px;border-radius:50%;border:none;padding:0;background:none;cursor:pointer;overflow:hidden;}
  .colour-custom::-webkit-color-swatch-wrapper{padding:0;}
  .colour-custom::-webkit-color-swatch{border:2px solid var(--card-border);border-radius:50%;}
  .fav-card{padding:14px;}
  .fav-card .fav-card-link{display:block;color:inherit;text-decoration:none;}
  .fav-card .row{font-size:13px;color:var(--muted);margin-top:6px;}
  .fav-card .row b{color:var(--text);font-weight:600;}
  .fav-card .colour-row{margin:12px 0 0;padding-top:10px;border-top:1px solid var(--card-border);}
  .center-msg{text-align:center;padding:60px 20px;color:var(--muted);font-size:14px;line-height:1.6;}
  .center-msg .big{font-size:34px;margin-bottom:10px;}
  code.small{background:#1c2128;padding:2px 5px;border-radius:5px;font-size:12px;}
  .spinner{width:16px;height:16px;border:2px solid var(--card-border);border-top-color:var(--green-bright);
    border-radius:50%;display:inline-block;animation:spin .8s linear infinite;vertical-align:-3px;}
  @keyframes spin{to{transform:rotate(360deg);}}
  @media (min-width:640px){
    nav.bottom{max-width:640px;left:50%;transform:translateX(-50%);border-left:1px solid var(--card-border);border-right:1px solid var(--card-border);border-radius:14px 14px 0 0;}
  }
</style>
</head>
<body>

<header class="top">
  <h1>U12 Results</h1>
  <div class="sub">
    <span>Foxes Sunday League · Burton Junior League</span>
    <span id="seasonLabel"></span>
    <span id="statusBadge" class="badge stale">Loading…</span>
  </div>
</header>

<main id="app"></main>

<nav class="bottom" id="bottomNav">
  <a href="#/" data-route="/"><span class="ic">🏠</span>Home</a>
  <a href="#/fixtures" data-route="/fixtures"><span class="ic">📅</span>Fixtures</a>
  <a href="#/results" data-route="/results"><span class="ic">⚽</span>Results</a>
  <a href="#/divisions" data-route="/divisions"><span class="ic">🏆</span>Divisions</a>
  <a href="#/favourites" data-route="/favourites"><span class="ic">⭐</span>Favourites</a>
</nav>

<script>
(function(){
"use strict";

// ---------------------------------------------------------------------
// CONFIG
// ---------------------------------------------------------------------
var CONFIG = {
  // Browsers can't call faapi.jwhsolutions.co.uk directly (no CORS
  // headers from that host, confirmed by a live "Couldn't reach the
  // Full-Time results service" error on this site). This points at the
  // small stateless Worker in foxes-proxy-worker.js instead, which
  // forwards requests server-to-server and adds the CORS headers back.
  // Replace this with your own Worker's *.workers.dev URL after deploying it.
  API_BASE: "https://foxes-proxy.tomfbaker.workers.dev",
  // Each competition: a league + season, and which of its divisions to show —
  // either every division whose name contains `nameFilter`, or exact `divisionIds`.
  COMPETITIONS: [
    { leagueId: "3326454",   seasonId: "503728397", name: "Leicestershire Foxes Sunday League", nameFilter: "U12" },
    { leagueId: "277092267", seasonId: "188709863", name: "Burton Junior Football League",     divisionIds: ["366287585"] } // BJFL U12
  ],
  DEFAULT_FAVOURITES: ["Mountsorrel Juniors U12 Shadowcats", "Ashby United Community FC U12 Mavericks"],
  CACHE_KEY: "foxes_u12_cache_v2",
  FAV_KEY: "foxes_u12_favourites_v2",
  HIDDEN_DIVISIONS_KEY: "foxes_u12_hidden_divisions_v1",
  FAV_COLORS_KEY: "foxes_u12_fav_colours_v1",
  DEFAULT_FAV_COLOR: "#3fb950",
  OLD_FAV_KEY: "foxes_u12_favourites_v1",
  REFRESH_MS: 20 * 60 * 1000, // 20 min background refresh while the tab is open
  FETCH_TIMEOUT_MS: 25000, // Fixtures/Results normally answer in ~1s; the Worker itself gives up at ~30s
  RETRIES: 1
};

// ---------------------------------------------------------------------
// Small helpers (ported from the server build's utils.js / mapping.js)
// ---------------------------------------------------------------------
var ENTITIES = {"&amp;":"&","&lt;":"<","&gt;":">","&quot;":'"',"&#39;":"'","&apos;":"'","&nbsp;":" "};
function decodeEntities(s){
  if (typeof s !== "string") return s;
  return s.replace(/&amp;|&lt;|&gt;|&quot;|&#39;|&apos;|&nbsp;/g, function(m){ return ENTITIES[m] || m; });
}
function cleanTeamName(name){
  if (!name) return name;
  return decodeEntities(String(name)).trim();
}
function parseFixtureDateTime(raw){
  if (!raw || typeof raw !== "string") return null;
  var m = raw.trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})(?:\s+(\d{1,2}):(\d{2}))?/);
  if (!m) return null;
  var dd = m[1], mm = m[2], yy = m[3], hh = m[4], min = m[5];
  var year = parseInt(yy, 10);
  if (year < 100) year += 2000;
  var day = parseInt(dd, 10), month = parseInt(mm, 10);
  if (month < 1 || month > 12 || day < 1 || day > 31) return null;
  var hour = hh !== undefined ? parseInt(hh, 10) : 0;
  var minute = min !== undefined ? parseInt(min, 10) : 0;
  var date = new Date(Date.UTC(year, month - 1, day, hour, minute));
  if (isNaN(date.getTime())) return null;
  return date.toISOString();
}
function firstDefined(obj, keys){
  for (var i=0;i<keys.length;i++){
    var k = keys[i];
    if (obj[k] !== undefined && obj[k] !== null && obj[k] !== "") return obj[k];
  }
  return undefined;
}
function numOrNull(v){
  if (v === undefined || v === null || v === "") return null;
  var n = Number(v);
  return isNaN(n) ? null : n;
}
function parseScoreString(s){
  if (typeof s !== "string") return null;
  var m = s.match(/(\d+)\s*[-:–]\s*(\d+)/);
  if (!m) return null;
  return { home: parseInt(m[1],10), away: parseInt(m[2],10) };
}
function inferStatus(raw){
  var statusField = firstDefined(raw, ["status","matchStatus","fixtureStatus","result","score"]);
  var text = String(statusField || "").toLowerCase();
  if (text.indexOf("postpon") !== -1) return "postponed";
  if (text.indexOf("cancel") !== -1) return "cancelled";
  if (text.indexOf("rearrang") !== -1 || text.indexOf("re-arrang") !== -1) return "rearranged";
  if (text.indexOf("complet") !== -1 || text.indexOf("played") !== -1 || text.indexOf("full time") !== -1) return "completed";
  return null;
}
function mapFixture(raw, divisionName){
  var rawDateTime = firstDefined(raw, ["fixtureDateTime","matchDate","date","kickOff"]);
  return {
    home: cleanTeamName(firstDefined(raw, ["homeTeam","home","homeTeamName"])),
    away: cleanTeamName(firstDefined(raw, ["awayTeam","away","awayTeamName"])),
    rawDateTime: rawDateTime || null,
    isoDateTime: parseFixtureDateTime(rawDateTime),
    location: firstDefined(raw, ["location","venue","ground"]) || null,
    competition: firstDefined(raw, ["competition","division","divisionName"]) || divisionName || null,
    status: inferStatus(raw) || "scheduled",
    homeScore: null, awayScore: null, hasScore: false
  };
}
function mapResult(raw, divisionName){
  var rawDateTime = firstDefined(raw, ["fixtureDateTime","matchDate","date","playedOn"]);
  var scoreStr = firstDefined(raw, ["score","result","scoreLine"]);
  var parsedScore = parseScoreString(scoreStr);
  var homeScoreRaw = firstDefined(raw, ["homeScore","homeGoals","homeTeamScore","fthg"]);
  var awayScoreRaw = firstDefined(raw, ["awayScore","awayGoals","awayTeamScore","ftag"]);
  var homeScore = homeScoreRaw !== undefined ? Number(homeScoreRaw) : (parsedScore ? parsedScore.home : null);
  var awayScore = awayScoreRaw !== undefined ? Number(awayScoreRaw) : (parsedScore ? parsedScore.away : null);
  return {
    home: cleanTeamName(firstDefined(raw, ["homeTeam","home","homeTeamName"])),
    away: cleanTeamName(firstDefined(raw, ["awayTeam","away","awayTeamName"])),
    rawDateTime: rawDateTime || null,
    isoDateTime: parseFixtureDateTime(rawDateTime),
    location: firstDefined(raw, ["location","venue","ground"]) || null,
    competition: firstDefined(raw, ["competition","division","divisionName"]) || divisionName || null,
    status: inferStatus(raw) || "completed",
    homeScore: (homeScore === null || isNaN(homeScore)) ? null : homeScore,
    awayScore: (awayScore === null || isNaN(awayScore)) ? null : awayScore,
    hasScore: !(homeScore === null || isNaN(homeScore) || awayScore === null || isNaN(awayScore))
  };
}
function mapTableRow(raw){
  return {
    position: numOrNull(firstDefined(raw, ["position","rank","pos"])),
    teamName: cleanTeamName(firstDefined(raw, ["teamName","team","name"])),
    played: numOrNull(firstDefined(raw, ["played","p","pld"])),
    won: numOrNull(firstDefined(raw, ["won","w","wins"])),
    drawn: numOrNull(firstDefined(raw, ["drawn","d","draws"])),
    lost: numOrNull(firstDefined(raw, ["lost","l","losses"])),
    goalsFor: numOrNull(firstDefined(raw, ["goalsFor","gf","for"])),
    goalsAgainst: numOrNull(firstDefined(raw, ["goalsAgainst","ga","against"])),
    goalDifference: numOrNull(firstDefined(raw, ["goalDifference","gd","goalDiff"])),
    points: numOrNull(firstDefined(raw, ["points","pts"]))
  };
}

// Merge a division's Fixtures list (whole-season, no scores) with its
// Results list (completed matches, with scores) into one match list.
// A fixture is matched to a result by team pair; if no fixtures data
// exists at all (e.g. Fixtures failed but Results worked), results are
// still shown standalone. Never invents a match that neither endpoint
// returned.
function mergeDivisionMatches(fixturesRaw, resultsRaw, divisionName){
  var fixtures = (fixturesRaw || []).map(function(r){ return mapFixture(r, divisionName); });
  var results = (resultsRaw || []).map(function(r){ return mapResult(r, divisionName); });
  var resultsByPair = {};
  results.forEach(function(r, idx){
    var key = r.home + "|" + r.away;
    (resultsByPair[key] = resultsByPair[key] || []).push(idx);
  });
  var used = {};
  var merged = fixtures.map(function(f){
    var key = f.home + "|" + f.away;
    var candidates = resultsByPair[key] || [];
    for (var i=0;i<candidates.length;i++){
      var idx = candidates[i];
      if (used[idx]) continue;
      used[idx] = true;
      var r = results[idx];
      var out = {};
      for (var k in f) out[k] = f[k];
      for (var k2 in r) out[k2] = r[k2];
      return out;
    }
    return f;
  });
  results.forEach(function(r, idx){
    if (!used[idx]) merged.push(r);
  });
  return merged;
}

function computeTableFromMatches(matches, teamNames){
  var stats = {};
  (teamNames || []).forEach(function(name){
    stats[name] = { teamName: name, played:0, won:0, drawn:0, lost:0, goalsFor:0, goalsAgainst:0, goalDifference:0, points:0 };
  });
  function ensure(name){
    if (!stats[name]) stats[name] = { teamName: name, played:0, won:0, drawn:0, lost:0, goalsFor:0, goalsAgainst:0, goalDifference:0, points:0 };
    return stats[name];
  }
  matches.forEach(function(m){
    if (!m.hasScore || m.status === "postponed" || m.status === "cancelled") return;
    var h = ensure(m.home), a = ensure(m.away);
    h.played++; a.played++;
    h.goalsFor += m.homeScore; h.goalsAgainst += m.awayScore;
    a.goalsFor += m.awayScore; a.goalsAgainst += m.homeScore;
    if (m.homeScore > m.awayScore){ h.won++; h.points+=3; a.lost++; }
    else if (m.homeScore < m.awayScore){ a.won++; a.points+=3; h.lost++; }
    else { h.drawn++; a.drawn++; h.points++; a.points++; }
  });
  var rows = Object.keys(stats).map(function(k){
    var s = stats[k];
    s.goalDifference = s.goalsFor - s.goalsAgainst;
    return s;
  });
  rows.sort(function(a,b){
    if (b.points !== a.points) return b.points - a.points;
    if (b.goalDifference !== a.goalDifference) return b.goalDifference - a.goalDifference;
    if (b.goalsFor !== a.goalsFor) return b.goalsFor - a.goalsFor;
    return a.teamName.localeCompare(b.teamName);
  });
  rows.forEach(function(r, i){ r.position = i + 1; });
  return rows;
}

// ---------------------------------------------------------------------
// fulltimeApi — the only code that talks to the external API.
// Never throws on an ordinary HTTP failure; returns {ok, data|error}.
// ---------------------------------------------------------------------
var fulltimeApi = (function(){
  function sleep(ms){ return new Promise(function(res){ setTimeout(res, ms); }); }

  function fetchWithRetry(url, retries){
    if (retries === undefined) retries = CONFIG.RETRIES;
    var attempt = 0;
    function tryOnce(){
      var controller = ("AbortController" in window) ? new AbortController() : null;
      var timer = null;
      if (controller) timer = setTimeout(function(){ controller.abort(); }, CONFIG.FETCH_TIMEOUT_MS);
      var opts = { headers: { accept: "application/json" } };
      if (controller) opts.signal = controller.signal;
      return fetch(url, opts).then(function(res){
        if (timer) clearTimeout(timer);
        if (res.ok) {
          return res.json().then(function(data){ return { ok:true, data:data, status:res.status }; });
        }
        if (res.status < 500) {
          return res.json().catch(function(){ return null; }).then(function(body){
            var msg = (body && body.error && body.error.message) || (body && body.title) || ("HTTP " + res.status);
            return { ok:false, status:res.status, error: msg, terminal:true };
          });
        }
        return Promise.reject(new Error("HTTP " + res.status));
      }).catch(function(err){
        if (timer) clearTimeout(timer);
        var msg = (err && err.message) || String(err);
        if (attempt < retries) {
          attempt++;
          var backoff = 700 * Math.pow(2, attempt) + Math.floor(Math.random()*250);
          return sleep(backoff).then(tryOnce);
        }
        return { ok:false, status:null, error: msg };
      });
    }
    return tryOnce();
  }

  var base = CONFIG.API_BASE.replace(/\/$/, "");
  return {
    searchDivisions: function(leagueId){
      return fetchWithRetry(base + "/api/Search/divisions/" + encodeURIComponent(leagueId));
    },
    getFixtures: function(divisionId, season){
      return fetchWithRetry(base + "/api/Fixtures/" + encodeURIComponent(divisionId) + "/season/" + encodeURIComponent(season));
    },
    getResults: function(divisionId, season){
      return fetchWithRetry(base + "/api/Results/" + encodeURIComponent(divisionId) + "/season/" + encodeURIComponent(season));
    }
  };
})();

// ---------------------------------------------------------------------
// Local cache (localStorage) — this IS the "database". Stale-while-
// revalidate: render whatever's cached immediately, refresh in the
// background, never blank the screen because of a failed fetch.
// ---------------------------------------------------------------------
var Cache = {
  load: function(){
    try {
      var raw = localStorage.getItem(CONFIG.CACHE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch(e){ return null; }
  },
  save: function(data){
    try { localStorage.setItem(CONFIG.CACHE_KEY, JSON.stringify(data)); } catch(e){ /* storage full/unavailable — ignore */ }
  }
};

var state = {
  cache: Cache.load(),   // { updatedAt, seasonLabel, divisions:[{externalId,name}], perDivision:{}, lastError }
  favourites: loadFavourites(),
  hiddenDivisions: loadHiddenDivisions(),   // division externalIds switched off (toggle lives on Divisions page, hides everywhere)
  favColors: loadFavColors(),   // { teamName: "#hex" } — per-team favourite highlight colour
  loading: false,
  fetchBlocked: false,   // set true if the very first attempt fails with no cache — likely CORS/network
  route: parseHash()
};

function loadFavourites(){
  try {
    var raw = localStorage.getItem(CONFIG.FAV_KEY);
    if (raw !== null) {
      var arr = JSON.parse(raw);
      return Array.isArray(arr) ? arr : [];
    }
    // First visit on v2: carry over any v1 favourites, then add the new defaults.
    var list = [];
    var old = localStorage.getItem(CONFIG.OLD_FAV_KEY);
    if (old !== null) { var o = JSON.parse(old); if (Array.isArray(o)) list = o.slice(); }
    CONFIG.DEFAULT_FAVOURITES.forEach(function(n){ if (list.indexOf(n) === -1) list.push(n); });
    localStorage.setItem(CONFIG.FAV_KEY, JSON.stringify(list));
    return list;
  } catch(e){ return CONFIG.DEFAULT_FAVOURITES.slice(); }
}
