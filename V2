}

function renderTeam(name){
  var html = renderBanner();
  if (!state.cache) return html + emptyOrLoading();
  var div = findTeamDivision(name);
  var matches = div ? getDivisionMatches(div.externalId) : [];
  var teamMatches = matches.filter(function(m){ return m.home === name || m.away === name; });
  if (!div && !teamMatches.length) {
    return html + '<div class="empty">“' + esc(name) + '” wasn’t found in the current U12 data.</div>';
  }
  var now = new Date().toISOString();
  var completed = teamMatches.filter(function(m){ return m.hasScore; }).sort(function(a,b){ return (b.isoDateTime||"").localeCompare(a.isoDateTime||""); });
  var upcoming = teamMatches.filter(function(m){ return !m.hasScore && m.isoDateTime && m.isoDateTime >= now; }).sort(function(a,b){ return (a.isoDateTime||"").localeCompare(b.isoDateTime||""); });
  var table = div ? getDivisionTable(div.externalId) : { rows: [] };
  var row = table.rows.find(function(r){ return r.teamName === name; });
  var fav = isFavourite(name);

  html += '<div class="team-hdr">' +
    '<h1>' + esc(name) + '</h1>' +
    '<button class="star-btn' + (fav?'':' off') + '" id="teamFavBtn">' + (fav?'★':'☆') + '</button>' +
  '</div>';
  if (div) html += '<div style="color:var(--muted);font-size:13px;margin-bottom:6px;">' + esc(div.name) + (div.leagueName ? ' · ' + esc(div.leagueName) : '') + '</div>';

  if (row) {
    html += '<div class="stat-grid">' +
      '<div class="stat"><div class="v">' + ordinal(row.position) + '</div><div class="l">Position</div></div>' +
      '<div class="stat"><div class="v">' + (row.played!==null?row.played:"—") + '</div><div class="l">Played</div></div>' +
      '<div class="stat"><div class="v">' + (row.points!==null?row.points:"—") + '</div><div class="l">Points</div></div>' +
      '<div class="stat"><div class="v">' + (row.goalDifference!==null?row.goalDifference:"—") + '</div><div class="l">GD</div></div>' +
    '</div>';
  }

  html += '<h2 class="section">Recent Results</h2>';
  html += completed.length ? '<div class="card">' + completed.slice(0,5).map(function(m){ return matchRow(m); }).join("") + '</div>' : '<div class="empty">No results yet.</div>';

  html += '<h2 class="section">Upcoming Fixtures</h2>';
  html += upcoming.length ? '<div class="card">' + upcoming.map(function(m){ return matchRow(m, {showVenue:true}); }).join("") + '</div>' : '<div class="empty">None scheduled.</div>';

  html += '<h2 class="section">Season Results</h2>';
  html += completed.length ? '<div class="card">' + completed.map(function(m){ return matchRow(m); }).join("") + '</div>' : '<div class="empty">No results yet.</div>';

  return html;
}

function renderFavourites(){
  var html = renderBanner();
  if (!state.cache) return html + emptyOrLoading();
  html += '<h2 class="section" style="margin-top:0;">⭐ My Favourites</h2>';
  if (!state.favourites.length) {
    html += '<div class="empty">No favourites yet. Search for a team or open a team page to add one.</div>';
  } else {
    html += state.favourites.map(function(n){ return renderFavouriteCard(n); }).join("");
  }
  html += '<h2 class="section">Add a Favourite</h2>';
  html += '<input class="search" id="favSearchInput" placeholder="Search teams to add…" autocomplete="off">';
  html += '<div id="favSearchResults"></div>';
  return html;
}

function renderSearch(query){
  var html = '<input class="search" id="searchInput" placeholder="Search teams…" value="' + esc(query||"") + '" autocomplete="off">';
  html += '<div id="searchResults">';
  html += searchResultsHtml(query || "");
  html += '</div>';
  return html;
}
function searchResultsHtml(query){
  if (!state.cache) return emptyOrLoading();
  var q = query.trim().toLowerCase();
  if (q.length < 2) return '<div class="empty">Type at least 2 letters…</div>';
  var matches = allTeamNames().filter(function(n){ return n.toLowerCase().indexOf(q) !== -1; });
  if (!matches.length) return '<div class="empty">No teams found.</div>';
  return '<div class="card">' + matches.map(function(name){
    var fav = isFavourite(name);
    return '<div class="match" style="align-items:center;">' +
      '<a href="#/team/' + encodeURIComponent(name) + '" style="flex:1;font-size:14px;">' + esc(name) + '</a>' +
      '<button class="star-btn' + (fav?'':' off') + '" data-toggle-fav="' + esc(name) + '">' + (fav?'★':'☆') + '</button>' +
    '</div>';
  }).join("") + '</div>';
}

function emptyOrLoading(){
  if (state.fetchBlocked) {
    return '<div class="center-msg"><div class="big">⚠️</div>' +
      "Couldn't reach the Full-Time results service.<br><br>" +
      "The results come from a free third-party service that is sometimes slow or offline. " +
      "Once it's back, this page will load normally and keep a saved copy for next time.<br>" +
      '<button class="btn" style="margin-top:14px;" onclick="location.reload()">Try again</button></div>';
  }
  var slow = state.loading && state.loadStartedAt && (Date.now() - state.loadStartedAt > 8000);
  return '<div class="center-msg"><span class="spinner"></span><br><br>Loading U12 results…' +
    (slow ? '<br><br><span style="font-size:13px;">The Full-Time results service is responding slowly right now. Still trying…</span>' : '') +
    '</div>';
}

function routeTitle(route){
  var titles = { "/":"Home", "/fixtures":"Fixtures", "/results":"Results", "/divisions":"Divisions", "/favourites":"Favourites" };
  return titles[route.path] || "";
}

function render(){
  var app = document.getElementById("app");
  var route = state.route;
  var html = "";
  if (route.path === "/") html = renderHome();
  else if (route.path === "/fixtures") html = renderFixtures();
  else if (route.path === "/results") html = renderResults();
  else if (route.path === "/divisions") html = renderDivisions();
  else if (route.path === "/division") html = renderDivision(route.param);
  else if (route.path === "/team") html = renderTeam(decodeURIComponent(route.param));
  else if (route.path === "/favourites") html = renderFavourites();
  else if (route.path === "/search") html = renderSearch(route.param || "");
  else html = renderHome();

  app.innerHTML = html;
  updateStatusBadge();
  updateNav();
  bindDynamicHandlers();
  window.scrollTo(0,0);
}

function updateStatusBadge(){
  var badge = document.getElementById("statusBadge");
  var seasonEl = document.getElementById("seasonLabel");
  if (state.cache && state.cache.seasonLabel) seasonEl.textContent = "· " + state.cache.seasonLabel + " season";
  if (state.loading) {
    badge.className = "badge stale"; badge.textContent = "Updating…";
    return;
  }
  if (!state.cache) {
    badge.className = "badge error"; badge.textContent = "No data";
    return;
  }
  var upd = fmtUpdated(state.cache.updatedAt);
  if (state.cache.lastError) {
    badge.className = "badge error";
    badge.textContent = upd ? ("Last updated " + upd) : "Unavailable";
  } else {
    badge.className = "badge live";
    badge.textContent = upd ? ("Updated " + upd) : "Live";
  }
}

function updateNav(){
  var links = document.querySelectorAll("nav.bottom a");
  for (var i=0;i<links.length;i++){
    var r = links[i].getAttribute("data-route");
    var active = (r === state.route.path) || (r === "/" && (state.route.path === "/division" || state.route.path === "/team"));
    links[i].className = active ? "active" : "";
  }
}

function bindDynamicHandlers(){
  var teamFavBtn = document.getElementById("teamFavBtn");
  if (teamFavBtn && state.route.path === "/team") {
    teamFavBtn.onclick = function(){ toggleFavourite(decodeURIComponent(state.route.param)); };
  }
  var divBtns = document.querySelectorAll("[data-toggle-division]");
  for (var j=0;j<divBtns.length;j++){
    divBtns[j].onclick = function(e){
      e.preventDefault();
      toggleDivision(this.getAttribute("data-toggle-division"));
    };
  }
  var teamSwatches = document.querySelectorAll("[data-fav-team-colour]");
  for (var k=0;k<teamSwatches.length;k++){
    teamSwatches[k].onclick = function(){
      setFavColorFor(this.getAttribute("data-fav-team-colour"), this.getAttribute("data-colour"));
    };
  }
  var teamCustomColours = document.querySelectorAll("[data-fav-team-colour-custom]");
  for (var m=0;m<teamCustomColours.length;m++){
    teamCustomColours[m].oninput = function(){
      setFavColorFor(this.getAttribute("data-fav-team-colour-custom"), this.value);
    };
  }
  var tabs = document.querySelectorAll(".tabs button[data-tab]");
  for (var i=0;i<tabs.length;i++){
    tabs[i].onclick = function(){ divisionTab = this.getAttribute("data-tab"); render(); };
  }
  var favSearchInput = document.getElementById("favSearchInput");
  if (favSearchInput) {
    favSearchInput.oninput = function(){
      document.getElementById("favSearchResults").innerHTML = searchResultsHtml(this.value);
      bindStarButtons();
    };
  }
  var searchInput = document.getElementById("searchInput");
  if (searchInput) {
    searchInput.oninput = function(){
      document.getElementById("searchResults").innerHTML = searchResultsHtml(this.value);
      bindStarButtons();
      history.replaceState(null, "", "#/search/" + encodeURIComponent(this.value));
    };
    searchInput.focus();
  }
  bindStarButtons();
}
function bindStarButtons(){
  var stars = document.querySelectorAll("[data-toggle-fav]");
  for (var i=0;i<stars.length;i++){
    stars[i].onclick = function(){ toggleFavourite(this.getAttribute("data-toggle-fav")); };
  }
}

// ---------------------------------------------------------------------
// Router
// ---------------------------------------------------------------------
function parseHash(){
  var h = location.hash.replace(/^#/, "") || "/";
  var parts = h.split("/").filter(Boolean);
  if (parts.length === 0) return { path: "/" };
  if (parts[0] === "division" && parts[1]) return { path: "/division", param: parts[1] };
  if (parts[0] === "team" && parts[1]) return { path: "/team", param: parts[1] };
  if (parts[0] === "search") return { path: "/search", param: decodeURIComponent(parts[1] || "") };
  if (["fixtures","results","divisions","favourites"].indexOf(parts[0]) !== -1) return { path: "/" + parts[0] };
  return { path: "/" };
}
window.addEventListener("hashchange", function(){
  state.route = parseHash();
  render();
});

// A basic search entry point via the nav isn't in the 5-item bottom nav
// (kept to the brief's core 5), but is reachable via the home search box.
function insertSearchEntry(){
  var sub = document.querySelector("header.top .sub");
  var a = document.createElement("a");
  a.href = "#/search";
  a.style.marginLeft = "auto";
  a.style.fontSize = "16px";
  a.textContent = "🔍";
  sub.parentNode.insertBefore(a, null);
}

// ---------------------------------------------------------------------
// Boot
// ---------------------------------------------------------------------
document.addEventListener("DOMContentLoaded", function(){
  addSearchLink();
  render();
  refreshData();
  setInterval(function(){
    if (document.visibilityState === "visible") refreshData();
  }, CONFIG.REFRESH_MS);
});

function addSearchLink(){
  var header = document.querySelector("header.top");
  var link = document.createElement("a");
  link.href = "#/search";
  link.textContent = "🔍 Search";
  link.style.cssText = "position:absolute;top:calc(14px + env(safe-area-inset-top));right:16px;font-size:13px;color:var(--muted);";
  header.style.position = "sticky";
  var wrap = document.createElement("div");
  wrap.style.position = "relative";
  header.parentNode.insertBefore(wrap, header);
  wrap.appendChild(header);
  wrap.appendChild(link);
}

})();
</script>
</body>
