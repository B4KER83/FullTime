function matchRow(m, opts){
  opts = opts || {};
  var homeFav = isFavourite(m.home), awayFav = isFavourite(m.away);
  var homeCls = homeFav ? "name fav" : "name";
  var awayCls = awayFav ? "name fav" : "name";
  var homeStyle = homeFav ? ' style="color:' + esc(favColorFor(m.home)) + '"' : '';
  var awayStyle = awayFav ? ' style="color:' + esc(favColorFor(m.away)) + '"' : '';
  var scoreHtml = m.hasScore
    ? '<span class="score">' + m.homeScore + ' – ' + m.awayScore + '</span>'
    : '<span class="vs">v</span>';
  var timeStr = fmtTime(m.isoDateTime, m.rawDateTime);
  var metaBits = [];
  if (timeStr) metaBits.push(timeStr);
  if (opts.showDivision && m.competition) metaBits.push(esc(m.competition));
  if (m.location && opts.showVenue) metaBits.push(esc(m.location));
  return (
    '<div class="match">' +
      '<div class="date">' + fmtDate(m.isoDateTime) + '</div>' +
      '<div class="teams">' +
        '<div class="t"><a class="' + homeCls + '"' + homeStyle + ' href="#/team/' + encodeURIComponent(m.home) + '">' + esc(m.home) + '</a>' + scoreHtml + '</div>' +
        '<div class="t"><a class="' + awayCls + '"' + awayStyle + ' href="#/team/' + encodeURIComponent(m.away) + '">' + esc(m.away) + '</a></div>' +
        (metaBits.length || statusTag(m.status) ? '<div class="meta">' + metaBits.join(" · ") + statusTag(m.status) + '</div>' : '') +
      '</div>' +
    '</div>'
  );
}

function renderBanner(){
  if (!state.cache) return "";
  var bits = [];
  if (state.cache.lastError) {
    bits.push('<div class="banner err">Unable to retrieve the latest data. Showing the most recently available results.</div>');
  }
  return bits.join("");
}

function renderHome(){
  var html = "";
  html += renderBanner();
  if (!state.cache) return html + emptyOrLoading();

  if (!state.favourites.length) {
    html += '<h2 class="section" style="margin-top:0;">My Favourites</h2>';
    html += '<div class="empty">No favourites yet — add a team from its page or search.</div>';
    return html;
  }

  var fav = favouriteMatches();
  var now = new Date().toISOString();
  var any = false;
  CONFIG.COMPETITIONS.forEach(function(c){
    var leagueFav = fav.filter(function(m){ return m.leagueId === c.leagueId; });
    var completed = leagueFav.filter(function(m){ return m.hasScore; })
      .sort(function(a,b){ return (b.isoDateTime||"").localeCompare(a.isoDateTime||""); })
      .slice(0,8);
    var upcoming = leagueFav.filter(function(m){ return !m.hasScore && m.isoDateTime && m.isoDateTime >= now && m.status !== "cancelled"; })
      .sort(function(a,b){ return (a.isoDateTime||"").localeCompare(b.isoDateTime||""); })
      .slice(0,8);
    if (!completed.length && !upcoming.length) return;
    html += '<h2 class="section"' + (any ? '' : ' style="margin-top:0;"') + '>' + esc(c.name) + '</h2>';
    any = true;
    html += '<h3 class="subsection">Latest Results</h3>';
    html += completed.length ? '<div class="card">' + completed.map(function(m){ return matchRow(m, {showDivision:true}); }).join("") + '</div>' : '<div class="empty">No completed results yet for your favourites.</div>';
    html += '<h3 class="subsection">Upcoming Fixtures</h3>';
    html += upcoming.length ? '<div class="card">' + upcoming.map(function(m){ return matchRow(m, {showDivision:true}); }).join("") + '</div>' : '<div class="empty">No upcoming fixtures found for your favourites.</div>';
  });
  if (!any) html += '<div class="empty" style="margin-top:0;">No results or fixtures found for your favourites yet.</div>';

  html += '<h2 class="section">My Favourites</h2>';
  html += state.favourites.map(function(n){ return renderFavouriteCard(n, {compact:true}); }).join("");
