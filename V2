// ---------------------------------------------------------------------
// Data refresh
// ---------------------------------------------------------------------
function refreshData(){
  if (state.loading) return Promise.resolve();
  state.loading = true;
  state.loadStartedAt = Date.now();
  setTimeout(function(){ if (state.loading) render(); }, 8100);
  render();

  function discover(comp){
    return fulltimeApi.searchDivisions(comp.leagueId).then(function(r){
      if (!r.ok) {
        // Fall back to this league's divisions from the last good load.
        var cached = ((state.cache && state.cache.divisions) || []).filter(function(d){ return d.leagueId === comp.leagueId; });
        return { ok: false, divisions: cached };
      }
      var all = (r.data || []).map(function(d){
        return { externalId: String(firstDefined(d, ["id","divisionId","externalId"])), name: cleanTeamName(firstDefined(d, ["name","divisionName","fullName"])) };
      }).filter(function(d){ return d.externalId && d.name; });
      var picked = all.filter(function(d){
        if (comp.divisionIds) return comp.divisionIds.indexOf(d.externalId) !== -1;
        return d.name.toUpperCase().indexOf(comp.nameFilter.toUpperCase()) !== -1;
      });
      picked.forEach(function(d){ d.leagueId = comp.leagueId; d.leagueName = comp.name; d.seasonId = comp.seasonId; });
      return { ok: true, divisions: picked };
    });
  }

  return Promise.all(CONFIG.COMPETITIONS.map(discover)).then(function(found){
    var divisions = [];
    found.forEach(function(f){ divisions = divisions.concat(f.divisions); });
    var anyDiscovered = found.some(function(f){ return f.ok; });
    if (!anyDiscovered && !divisions.length) {
      state.loading = false;
      if (!state.cache) state.fetchBlocked = true;
      render();
      return;
    }
    state.fetchBlocked = false;

    var perDivision = (state.cache && state.cache.perDivision) || {};
    var years = [];
    var prevUpdatedAt = state.cache ? state.cache.updatedAt : null;

    // Push whatever has arrived so far to the screen. Called after every
    // division, so one slow division never holds the whole page on "Loading…".
    function publish(final){
      var anyOk = divisions.some(function(d){
        var e = perDivision[d.externalId];
        return e && e.lastOk && (e.lastOk.fixtures || e.lastOk.results);
      });
      var seasonLabel = years.length ? (Math.min.apply(null, years) === Math.max.apply(null, years) ? years[0] : (Math.min.apply(null, years) + "–" + Math.max.apply(null, years))) : (state.cache ? state.cache.seasonLabel : null);
      state.cache = {
        updatedAt: final && anyOk ? new Date().toISOString() : prevUpdatedAt,
        seasonLabel: seasonLabel,
        divisions: divisions,
        perDivision: perDivision,
        lastError: (final && !anyOk) ? "The Full-Time data service didn't respond for any division this time." : null
      };
      Cache.save(state.cache);
      if (final) state.loading = false;
      render();
    }

    // Only Fixtures + Results are fetched. The upstream League-table
    // endpoint has never returned rows (always an empty table) and currently
    // hangs for 50s+, so the table is calculated from results instead.
    var jobs = divisions.map(function(div){
      return Promise.all([
        fulltimeApi.getFixtures(div.externalId, div.seasonId),
        fulltimeApi.getResults(div.externalId, div.seasonId)
      ]).then(function(res){
        var fx = res[0], rs = res[1];
        var prev = perDivision[div.externalId] || {};
        var entry = {
          name: div.name,
          fixturesRaw: fx.ok ? fx.data : (prev.fixturesRaw || []),
          resultsRaw: rs.ok ? rs.data : (prev.resultsRaw || []),
          tableRaw: null,
          errors: {
            fixtures: fx.ok ? null : (fx.error || "unavailable"),
            results: rs.ok ? null : (rs.error || "unavailable")
          },
          lastOk: { fixtures: fx.ok, results: rs.ok }
        };
        perDivision[div.externalId] = entry;

        (entry.fixturesRaw || []).forEach(function(r){
          var dt = firstDefined(r, ["fixtureDateTime","matchDate","date","kickOff"]);
          var iso = parseFixtureDateTime(dt);
          if (iso) years.push(iso.slice(0,4));
        });
        publish(false);
      });
    });

    return Promise.all(jobs).then(function(){ publish(true); });
  }).catch(function(err){
    state.loading = false;
    if (!state.cache) state.fetchBlocked = true;
    render();
  });
}

// ---------------------------------------------------------------------
// Derived data helpers
// ---------------------------------------------------------------------
function getDivisionMatches(externalId){
  if (!state.cache || !state.cache.perDivision[externalId]) return [];
  var entry = state.cache.perDivision[externalId];
  return mergeDivisionMatches(entry.fixturesRaw, entry.resultsRaw, entry.name);
}
function getDivisionTable(externalId){
  if (!state.cache || !state.cache.perDivision[externalId]) return { rows: [], source: null };
  var entry = state.cache.perDivision[externalId];
  // API returns { divisionName, table: [...] }; table is currently always empty upstream.
  var apiRows = entry.tableRaw && (Array.isArray(entry.tableRaw) ? entry.tableRaw : entry.tableRaw.table);
  if (apiRows && apiRows.length) {
    return { rows: apiRows.map(mapTableRow), source: "api" };
  }
  var matches = getDivisionMatches(externalId);
  var teamNames = {};
  matches.forEach(function(m){ teamNames[m.home]=1; teamNames[m.away]=1; });
  var rows = computeTableFromMatches(matches, Object.keys(teamNames));
  return { rows: rows, source: rows.length ? "computed" : null };
}
function allMatchesAcrossDivisions(){
  // Excludes any division the user has switched off on the Divisions page —
  // this is what makes the toggle apply everywhere (Home, Fixtures, Results).
  if (!state.cache) return [];
  var out = [];
  state.cache.divisions.forEach(function(d){
    if (state.hiddenDivisions.indexOf(d.externalId) !== -1) return;
    getDivisionMatches(d.externalId).forEach(function(m){
      m.divisionExternalId = d.externalId;
      m.leagueId = d.leagueId;
      out.push(m);
    });
  });
  return out;
}
function favouriteMatches(){
  // Favourites always show, even if their league has been switched off —
  // a favourite is an explicit choice that shouldn't get hidden that way.
  var out = [];
  var seen = {};
  state.favourites.forEach(function(name){
    var div = findTeamDivision(name);
    if (!div) return;
    getDivisionMatches(div.externalId).forEach(function(m){
      if (m.home !== name && m.away !== name) return;
      var key = (m.home||"") + "|" + (m.away||"") + "|" + (m.isoDateTime||m.rawDateTime||"");
      if (seen[key]) return;
      seen[key] = 1;
      m.divisionExternalId = div.externalId;
      m.leagueId = div.leagueId;
      out.push(m);
    });
  });
  return out;
}
function findTeamDivision(teamName){
  if (!state.cache) return null;
  for (var i=0;i<state.cache.divisions.length;i++){
    var d = state.cache.divisions[i];
    var matches = getDivisionMatches(d.externalId);
    for (var j=0;j<matches.length;j++){
      if (matches[j].home === teamName || matches[j].away === teamName) return d;
    }
  }
  return null;
}
function allTeamNames(){
  var names = {};
  allMatchesAcrossDivisions().forEach(function(m){ names[m.home]=1; names[m.away]=1; });
  return Object.keys(names).sort();
}
function fmtDate(iso){
  if (!iso) return "—";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return "—";
  var months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return d.getUTCDate() + " " + months[d.getUTCMonth()];
}
function fmtTime(iso, raw){
  var m = raw && String(raw).match(/(\d{1,2}):(\d{2})/);
  if (m) return m[0];
  if (!iso) return "";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  var hh = d.getUTCHours(); var mm = d.getUTCMinutes();
  if (hh === 0 && mm === 0) return "";
  return (hh<10?"0":"")+hh+":"+(mm<10?"0":"")+mm;
}
function fmtUpdated(iso){
  if (!iso) return null;
  var d = new Date(iso);
  if (isNaN(d.getTime())) return null;
  var hh = d.getHours(), mm = d.getMinutes();
  return (hh<10?"0":"")+hh+":"+(mm<10?"0":"")+mm;
}
function esc(s){
  if (s === null || s === undefined) return "";
  return String(s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}
function statusTag(status){
  if (status === "postponed" || status === "cancelled" || status === "rearranged") {
    return '<span class="status-tag ' + status + '">' + status + "</span>";
  }
  return "";
}

// ---------------------------------------------------------------------
