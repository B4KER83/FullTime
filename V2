function renderFavouriteCard(name, opts){
  opts = opts || {};
  var color = favColorFor(name);
  var div = findTeamDivision(name);
  var matches = div ? getDivisionMatches(div.externalId) : [];
  var teamMatches = matches.filter(function(m){ return m.home === name || m.away === name; });
  var now = new Date().toISOString();
  var last = teamMatches.filter(function(m){ return m.hasScore; }).sort(function(a,b){ return (b.isoDateTime||"").localeCompare(a.isoDateTime||""); })[0];
  var next = teamMatches.filter(function(m){ return !m.hasScore && m.isoDateTime && m.isoDateTime >= now; }).sort(function(a,b){ return (a.isoDateTime||"").localeCompare(b.isoDateTime||""); })[0];
  var table = div ? getDivisionTable(div.externalId) : { rows: [] };
  var row = table.rows.find(function(r){ return r.teamName === name; });

  var found = !!div || teamMatches.length;
  var html = '<div class="card fav-card">';
  html += '<a href="#/team/' + encodeURIComponent(name) + '" class="fav-card-link">';
