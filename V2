var FAV_COLOR_PRESETS = ["#3fb950", "#58a6ff", "#f85149", "#d29922", "#a371f7", "#ffffff"];
function favColourRow(name){
  var color = favColorFor(name);
  var html = '<div class="colour-row">';
  html += FAV_COLOR_PRESETS.map(function(c){
    var on = color.toLowerCase() === c.toLowerCase();
    return '<button class="colour-swatch' + (on ? ' on' : '') + '" style="background:' + c + ';" ' +
      'data-fav-team-colour="' + esc(name) + '" data-colour="' + c + '" title="' + c + '"></button>';
  }).join("");
